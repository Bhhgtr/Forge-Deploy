  "scripts": {
    "build": "tsc -b",
    "start": "node dist/control-plane/src/index.js",
    "dev": "concurrently -k -n tsc,node \"tsc -b --watch --preserveWatchOutput\" \"nodemon --watch dist --ext js --exec node dist/control-plane/src/index.js\"",
